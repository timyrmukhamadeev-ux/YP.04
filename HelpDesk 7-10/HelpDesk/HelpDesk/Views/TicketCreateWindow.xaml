<Window x:Class="HelpDesk.Views.TicketCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Новая заявка" Height="520" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Новая заявка" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Категория" Margin="0,0,0,5"/>
            <ComboBox x:Name="CategoryComboBox" Height="35" FontSize="14" SelectedIndex="0">
                <ComboBoxItem Content="Выберите категорию" IsEnabled="False"/>
                <ComboBoxItem Content="Оборудование"/>
                <ComboBoxItem Content="Программное обеспечение"/>
                <ComboBoxItem Content="Сеть"/>
                <ComboBoxItem Content="Учётная запись"/>
                <ComboBoxItem Content="Периферия"/>
                <ComboBoxItem Content="Другое"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Описание проблемы" Margin="0,0,0,5"/>
            <TextBox x:Name="DescriptionTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="Приоритет" Margin="0,0,0,5"/>
            <ComboBox x:Name="PriorityComboBox" Height="35" FontSize="14" SelectedIndex="1">
                <ComboBoxItem Content="Низкий"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Высокий"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="SaveButton" Content="Сохранить" Width="120" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="120" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>