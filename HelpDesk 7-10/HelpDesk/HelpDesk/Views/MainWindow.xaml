<Window x:Class="HelpDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Заявки" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="HelpDesk" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Система обработки заявок" FontSize="14" Opacity="0.7" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CurrentUserTextBlock" Grid.Column="1"
                       Text="Пользователь: admin" FontSize="14"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="Заявки технической поддержки"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Поиск" Margin="0,0,0,5"/>
                <TextBox x:Name="SearchTextBox" Height="32" FontSize="14"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Статус" Margin="0,0,0,5"/>
                <ComboBox x:Name="StatusComboBox" Height="32" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Новая"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Выполнена"/>
                    <ComboBoxItem Content="Отклонена"/>
                </ComboBox>
            </StackPanel>

            <Button x:Name="SearchButton" Grid.Column="4" Content="Найти"
                    Height="32" VerticalAlignment="Bottom" Click="SearchButton_Click"/>

            <Button x:Name="ResetFilterButton" Grid.Column="6" Content="Сбросить"
                    Height="32" VerticalAlignment="Bottom" Click="ResetFilterButton_Click"/>
        </Grid>

        <DataGrid x:Name="TicketsDataGrid" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="140"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="AddTicketButton" Content="Добавить" Click="AddTicketButton_Click"/>
            <Button x:Name="EditTicketButton" Content="Редактировать" Click="EditTicketButton_Click"/>
            <Button x:Name="DeleteTicketButton" Content="Удалить" Click="DeleteTicketButton_Click"/>
            <Button x:Name="LogoutButton" Content="Выйти" Click="LogoutButton_Click" Margin="20,5,5,5"/>
        </StackPanel>
    </Grid>
</Window>