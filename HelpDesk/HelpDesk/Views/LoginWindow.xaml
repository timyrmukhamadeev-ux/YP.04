<Window x:Class="HelpDesk.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk" Height="420" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="HelpDesk" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Система обработки заявок" FontSize="14" Opacity="0.7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Логин" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Пароль" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordInput" Height="32" FontSize="14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Button x:Name="LoginButton" Grid.Row="2" Content="Войти" Width="150"
                HorizontalAlignment="Center" Click="LoginButton_Click"/>
    </Grid>
</Window>